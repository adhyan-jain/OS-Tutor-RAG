# Ollama base URL (src/config.py GenerationConfig.ollama_base_url,
# api/routes/chat.py, api/routes/models.py). Optional -- defaults to
# http://localhost:11434. Set this when Ollama isn't co-located with the
# process, e.g. a container reaching the Docker host's Ollama at
# http://host.docker.internal:11434 (see docker-compose.yml).
OLLAMA_HOST=http://localhost:11434

# Local index directory (src/config.py PathConfig.index_dir /
# RetrievalConfig.index_dir). Optional -- defaults to data/index. Override
# to point at a mounted persistent volume in a container deploy.
INDEX_DIR=data/index

# --- Gated Google OAuth (api/auth.py, frontend/auth.ts) ---------------------
# Two on/off switches, same semantics, both default to disabled ("false"):
# truthy only for "true" or "1" (case-insensitive); unset, "false", "0", or
# anything else means disabled. When both are disabled (the default), the app
# behaves exactly as it does with no auth feature at all -- no login screen,
# no token validation, session history keyed by the client's session_id. Only
# set these to "true" once you have real Google OAuth credentials below.

# Backend switch (api/auth.py). When false, /chat and /models never invoke
# the auth dependency at all.
AUTH_ENABLED=false

# Frontend switch (frontend/auth.ts, frontend/components/AuthGate.tsx). Must
# be NEXT_PUBLIC_-prefixed to be readable in client components. When false,
# the chat UI renders immediately with no SessionProvider/login screen and no
# auth-related network calls -- importing the NextAuth config in this state
# does not require any of the vars below to be set.
NEXT_PUBLIC_AUTH_ENABLED=false

# Only required when NEXT_PUBLIC_AUTH_ENABLED=true:
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Signs/verifies NextAuth's session JWT, AND is reused as the shared secret
# for the small custom API token NextAuth mints in its jwt/session callbacks
# (frontend/auth.ts) -- the one the frontend sends as `Authorization: Bearer
# <token>` and api/auth.py decodes with PyJWT (algorithms=["HS256"]). One
# secret, one fewer env var to keep in sync; generate with e.g.
# `openssl rand -base64 32`.
NEXTAUTH_SECRET=your-nextauth-secret
