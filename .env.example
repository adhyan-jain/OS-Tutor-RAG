# S3-backed index persistence (src/indexing/s3_sync.py, scripts/reindex.py,
# api/pipeline_instance.py). All optional for local dev -- if S3_BUCKET is
# unset, S3 sync is skipped entirely and the app/scripts use whatever local
# index already exists in data/index/.

S3_BUCKET=your-bucket-name          # required for any S3 sync to happen at all
S3_PREFIX=os-tutor-rag/index        # key prefix under the bucket the index files are stored at
AWS_ACCESS_KEY_ID=your-access-key-id       # S3/R2 credentials; omit to use boto3's default credential chain
AWS_SECRET_ACCESS_KEY=your-secret-access-key  # S3/R2 credentials; omit to use boto3's default credential chain
S3_ENDPOINT_URL=                    # optional -- only needed for Cloudflare R2 or another S3-compatible provider; leave unset for real AWS S3
